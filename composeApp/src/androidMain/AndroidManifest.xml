<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Strip the AdMob SDK's auto-merged AD_ID permission. Ads are hard-coded
         off for this release (see FeatureFlags.adsEnabled + RemoteConfigKeys)
         and `MobileAds.initialize()` is gated so the SDK never starts. Keeping
         AD_ID in the merged manifest would force a "Yes, my app collects
         Advertising ID" answer on Play Console's Advertising ID declaration
         and drag advertising-data collection into our Data Safety form — for
         a build that shows zero ads. Remove this `tools:node="remove"` line
         when the ad rendering wiring is verified and we actually want the
         capability back in a future release. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <application
        android:name=".MyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mooney">
        <activity
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|layoutDirection|locale|mcc|navigation|smallestScreenSize|touchscreen|uiMode"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Mooney.Splash"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Disable Firebase Analytics' automatic screen_view auto-collection.
             We fire our own domain events (transaction_added, paywall_viewed,
             etc.) so the auto-screen_view stream is pure noise in the Firebase
             event log — dashboards get cleaner without it, and we lose nothing
             because Analytics' cohort/retention charts key off `session_start`,
             not screen views. -->
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />

        <!-- TODO(production-ad-id): replace this Google test AdMob App ID with the real
             ca-app-pub-7021633711522076~<android-app-id> from the AdMob console before release. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <!-- Google Mobile Ads and Firebase Analytics both ship an AD_SERVICES_CONFIG
             property pointing at different XML files. AdMob's gma_ad_services_config
             is the canonical one for apps that show ads, so we pin it explicitly. -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />
    </application>

</manifest>