<?xml version="1.0" encoding="utf-8"?>
<!--
    Balance widget metadata — describes the widget to the launcher's picker
    and constrains the resize behavior. Numbers below are the launcher-side
    sizing; the Glance composition inside `BalanceWidget.kt` handles
    responsive layout via `SizeMode.Responsive`.

    minWidth/minHeight: bounding box the OS will draw us in (smaller than the
        Small breakpoint since Android measures widget cells including gutters).
    targetCellWidth/Height: Android 12+ hint expressing "give me 2×2 by default".
    resizeMode: horizontal|vertical so users can stretch us to the medium size.
    previewLayout: a Compose-rendered preview shown in the picker.
    description/label: shown next to the preview.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="130dp"
    android:minHeight="130dp"
    android:minResizeWidth="130dp"
    android:minResizeHeight="130dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewImage="@drawable/widget_preview_balance"
    android:description="@string/widget_balance_description" />
